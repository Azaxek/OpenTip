# --- Required ---
# Postgres connection string (Neon or Supabase pooled URL). Local dev: `npm run dev:db` then use the URL it prints.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# 32+ random chars. Generate everything at once with: npm run keys
APP_SECRET=
# Protects the one-time /setup wizard on a fresh deployment. Pick any long random string.
SETUP_TOKEN=
# Public base URL (used in QR codes, escalation links, posters). No trailing slash.
APP_URL=http://localhost:3000

# --- Evidence storage (private bucket). Cloudflare R2 or Supabase Storage (S3 API). ---
# STORAGE_DRIVER=fs stores files in ./.storage (local dev/tests ONLY - not for Vercel).
STORAGE_DRIVER=fs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Bot protection (Cloudflare Turnstile). Required in production. ---
# Cloudflare's always-pass test keys for local dev: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Web Push (optional). `npm run keys` generates a pair. ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# --- Staff email for escalations (optional; Resend free tier) ---
RESEND_API_KEY=
RESEND_FROM=OpenTip <alerts@example.org>

# --- Scheduled purge (Vercel Cron sends this as a bearer token) ---
CRON_SECRET=

# --- Local trial database only (npm run dev:db). Never set these against a real database. ---
# PG_POOL_MAX=1
# PG_SIMPLE_PROTOCOL=1
